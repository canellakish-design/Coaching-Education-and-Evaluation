rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Evaluator / admin accounts.
    function isAdmin() {
      return request.auth != null
             && request.auth.token.email.lower() in ['canellakish@gmail.com', 'harry.canellakis@mdunitedfc.org'];
    }

    // Allowlist of approved coach emails. Doc ID = lowercased email.
    // Not writable from the client — add/remove coaches in the Firebase console.
    match /approvedCoaches/{email} {
      allow read: if request.auth != null && request.auth.token.email.lower() == email;
      allow write: if false;
    }

    // Coach profiles. A coach reads/writes their own; admins may list all
    // so the evaluator view can populate its coach selector.
    match /coaches/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Evaluation docs, keyed "{season}_{coachUid}".
    // A coach reads/writes only their own; admins read/write any so they can
    // grade rubric items and assign archetypes.
    match /coachEvaluations/{docId} {
      allow read, write: if request.auth != null
                          && (docId.matches('.*_' + request.auth.uid) || isAdmin());
    }

    // Outgoing mail queue for the "Trigger Email" extension. Only evaluators
    // can queue a send (via sending a coach a note); nobody reads it back.
    match /mail/{mailId} {
      allow read: if false;
      allow create: if request.auth != null && isAdmin();
      allow update, delete: if false;
    }
  }
}

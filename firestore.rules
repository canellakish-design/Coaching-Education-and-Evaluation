rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Document IDs are "{uid}_{season}". A coach can only read/write
    // documents whose ID starts with their own uid, and only if the
    // uid field inside the document matches their own uid too.
    match /coachSeasons/{docId} {
      allow read, write: if request.auth != null
        && docId.matches(request.auth.uid + '_.*')
        && request.resource.data.uid == request.auth.uid;
      allow read: if request.auth != null
        && docId.matches(request.auth.uid + '_.*');
    }
  }
}
